      "refersTo": "menu-toggle",
      "description": "Transparent two-stroke control; inherits paper on the hero and ink on editorial pages.",
      "html": "<button class=\"ds-menu-toggle\" aria-label=\"Open menu\"><span></span><span></span></button>",
      "css": ".ds-menu-toggle{display:flex;flex-direction:column;justify-content:center;gap:8px;width:30px;height:44px;padding:0;border:0;background:transparent;color:var(--paper,#f0f0f0);cursor:pointer}.ds-menu-toggle span{width:30px;height:2px;background:currentColor;transition:transform 360ms cubic-bezier(.16,1,.3,1)}.ds-menu-toggle:hover span:first-child{transform:translateY(2px)}.ds-menu-toggle:hover span:last-child{transform:translateY(-2px)}.ds-menu-toggle:focus-visible{outline:2px solid currentColor;outline-offset:7px}@media(prefers-reduced-motion:reduce){.ds-menu-toggle span{transition:none}}"
    },
