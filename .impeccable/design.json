      "css": ".ds-close-menu{width:40px;height:44px;display:grid;place-items:center;color:var(--paper,#f0f0f0);border:0;background:transparent;padding:0;cursor:pointer;transition:transform 320ms cubic-bezier(.16,1,.3,1)}.ds-close-menu svg{width:34px;height:34px}.ds-close-menu:hover{transform:rotate(90deg)}.ds-close-menu:focus-visible{outline:2px solid currentColor;outline-offset:7px}@media(prefers-reduced-motion:reduce){.ds-close-menu{transition:none}}"
